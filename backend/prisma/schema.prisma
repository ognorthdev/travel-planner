generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Trip {
  id                   String   @id @default(cuid())
  name                 String
  destination          String
  startDate            DateTime
  endDate              DateTime
  coverImageUrl        String?
  mealPreferences      String?
  activityPreferences  String?
  modelConfig          String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  days                 Day[]
  ideas                Idea[]
  chatSummary          ChatSummary?
  apiCosts             ApiCost[]
}

model ApiCost {
  id           String   @id @default(cuid())
  tripId       String
  service      String
  operation    String
  model        String?
  costCents    Float    @default(0)
  inputTokens  Int?
  outputTokens Int?
  createdAt    DateTime @default(now())
  trip         Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
}

model Day {
  id        String   @id @default(cuid())
  tripId    String
  date      DateTime
  dayNumber Int
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  slots     Slot[]

  @@unique([tripId, dayNumber])
}

model Slot {
  id        String   @id @default(cuid())
  dayId     String
  type      String
  sortOrder Int      @default(0)
  data      String   @default("{}")
  day       Day      @relation(fields: [dayId], references: [id], onDelete: Cascade)
}

model Idea {
  id          String   @id @default(cuid())
  tripId      String
  type        String
  name        String
  description String   @default("")
  data        String   @default("{}")
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  trip        Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
}

model ChatSummary {
  id        String   @id @default(cuid())
  tripId    String   @unique
  summary   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
}
