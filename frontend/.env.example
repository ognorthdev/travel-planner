# Supabase (Project Settings → API). The anon key is safe to expose client-side.
VITE_SUPABASE_URL=https://[REF].supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_public_key

# Backend origin. Leave empty in local dev (Vite proxies /api to the backend).
# In production set to the deployed backend URL, e.g. https://travel-planner.onrender.com
VITE_API_URL=
